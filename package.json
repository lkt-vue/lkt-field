{
  "name": "lkt-field",
  "version": "2.0.8",
  "description": "",
  "keywords": [
    "lkt",
    "lkt-web-tech",
    "ts",
    "typescript",
    "vue",
    "vue3",
    "js",
    "javascript",
    "field",
    "input",
    "ui"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./styles": "./dist/index.css",
    "./theme": "./theme/default.css",
    "./theme/default": "./theme/default.css"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "src/**/*.vue",
    "theme/**/*.css"
  ],
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "vite build && node clean-dts.js",
    "build-original": "vue-tsc --declaration --emitDeclarationOnly; vite build; tsc --project tsconfig.build.json; cp build/* dist/",
    "rebuild": "rm -rf dist/*; vue-tsc --declaration --emitDeclarationOnly; vite build; tsc --project tsconfig.build.json; cp build/* dist/"
  },
  "author": "Antonio Ibáñez",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/types": "^7.23.6",
    "@types/node": "^20.11.19",
    "@types/rollup": "^0.54.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "rollup": "^4.34.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vite-plugin-dts": "^4.5.0",
    "vue-tsc": "^2.2.0"
  },
  "dependencies": {
    "sortablejs": "^1.15.6",
    "suneditor": "^2.47.5"
  },
  "peerDependencies": {
    "lkt-anchor": "^2.0.2",
    "lkt-button": "^2.0.18",
    "lkt-date-tools": "^1.0.4",
    "lkt-http-client": "^1.0.34",
    "lkt-i18n": "^1.1.0",
    "lkt-modal": "^2.0.5",
    "lkt-object-tools": "^1.0.3",
    "lkt-string-tools": "^1.1.0",
    "lkt-toast": "^1.1.4",
    "lkt-tooltip": "^1.2.1",
    "lkt-vue-kernel": "^1.0.55",
    "vue": "^3.3.0"
  }
}
